# Real Anthropic API — leave ANTHROPIC_BASE_URL unset to use these.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- OR: point at the repo's local llama-server instead (no API key needed) ---
# Same pattern as whatsap/.env: the Anthropic SDK reads ANTHROPIC_BASE_URL from
# the environment on its own, so this needs no code change. Start llama-server
# first (see repo root README.md / docker-compose.yml), then uncomment:
# ANTHROPIC_API_KEY=not-necessary
# ANTHROPIC_MODEL=not-necessary
# ANTHROPIC_BASE_URL=http://localhost:5050
# MAX_TOKENS=50000

# The extension's ID (extension/manifest.config.ts pins a "key" field so this
# is stable across rebuilds — see docs/user-guides/config.md for the default
# project dev key's ID, or compute your own if you swap in a different key).
EXTENSION_ID=
PORT=4100
# Max characters of attached page/selection context sent to the agent per
# message; longer context is truncated with a note (see context.ts).
MAX_CONTEXT_CHARS=20000
