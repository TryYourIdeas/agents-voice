{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["chrome", "vite/client", "@testing-library/jest-dom"]
  },
  "include": ["src", "vitest.setup.ts", "vitest.config.ts"]
}
