ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
TAVILY_API_KEY=
# Max output tokens per agent response, and llama-server's -n/--n-predict
# default (see start-llama-server.sh / start-llama-server-gpu.sh).
MAX_TOKENS=40000
# Timezone the agent reports as "now" (IANA name). Falls back to TZ, then the system zone.
AGENT_TIMEZONE=
# Yahoo Mail tools (yahoo_get_new_emails / yahoo_send_email). Generate an App Password at
# Yahoo Account > Security > Generate app password; the normal password does not work.
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
