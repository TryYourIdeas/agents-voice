ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
TAVILY_API_KEY=
# Max output tokens per agent response, and llama-server's -n/--n-predict
# default (see start-llama-server.sh / start-llama-server-gpu.sh).
MAX_TOKENS=40000
# Timezone the agent reports as "now" (IANA name). Falls back to TZ, then the system zone.
AGENT_TIMEZONE=
# Yahoo Mail tools (yahoo_get_new_emails / yahoo_send_email). Generate an App Password at
# Yahoo Account > Security > Generate app password; the normal password does not work.
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
# SQLite agent log (user messages, agent/sub-agent replies, tool results) for analysis.
# Default: ../logs/agent-logs.db relative to whatsap/. Set AGENT_LOGS_ENABLED=false to turn off.
AGENT_LOGS_DB=
AGENT_LOGS_ENABLED=true
AGENT_LOGS_MAX_CHARS=100000
# Real name of the model behind the agent, stored in each log row's "Reasoning Model" field
# (ANTHROPIC_MODEL is only a placeholder when talking to llama-server). Defaults to ANTHROPIC_MODEL.
REASONING_MODEL_NAME=
# SQLite file with the model configurations managed in the UI (/models), used to replay logged turns.
# Default: ../logs/model-configs.db relative to whatsap/.
MODEL_CONFIGS_DB=

# generate-posts project used by the post-writer agent (default ../generate-posts)
GENERATE_POSTS_DIR=
